generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  logoUrl       String?
  industry      String?
  headquarters  String?
  employeeCount String?
  founded       Int?
  website       String?

  overallRating   Float?
  workLifeBalance Float?
  salaryBenefits  Float?
  jobSecurity     Float?
  careerGrowth    Float?
  companyCulture  Float?

  reviews       Review[]
  salaries      Salary[]
  benefits      Benefit[]
  sentimentData SentimentSnapshot[]
  userReviews   UserReview[]
  userSalaries  UserSalarySubmission[]
  interviews    Interview[]
  watchlistedBy Watchlist[]

  source        String    @default("seed")
  lastScrapedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Review {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title             String?
  role              String?
  location          String?
  rating            Float?
  pros              String
  cons              String
  sentiment         String?
  sentimentScore    Float?
  isCurrentEmployee Boolean?
  reviewDate        DateTime?
  createdAt         DateTime @default(now())
}

model Salary {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        String
  location    String?
  minSalary   Int
  maxSalary   Int
  avgSalary   Int?
  currency    String  @default("INR")
  experience  String?
  sampleCount Int?
  createdAt   DateTime @default(now())
}

model Benefit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  String
  name      String
  details   String?
}

model SentimentSnapshot {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positiveCount     Int
  negativeCount     Int
  neutralCount      Int
  topPositiveThemes String
  topNegativeThemes String
  analyzedAt        DateTime @default(now())
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  displayName     String?
  passwordHash    String
  currentCompany  String?
  currentRole     String?
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  reviews         UserReview[]
  salaries        UserSalarySubmission[]
  upvotes         UserReviewUpvote[]
  watchlist       Watchlist[]
}

model UserReview {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                 String
  role                  String
  location              String?
  overallRating         Float
  workLifeBalanceRating Float?
  salaryRating          Float?
  jobSecurityRating     Float?
  careerGrowthRating    Float?
  companyCultureRating  Float?
  pros                  String
  cons                  String
  isAnonymous           Boolean  @default(true)
  isCurrentEmployee     Boolean  @default(false)
  upvotes               Int      @default(0)
  createdAt             DateTime @default(now())
  upvotedBy             UserReviewUpvote[]
}

model UserReviewUpvote {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    UserReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, reviewId])
}

model UserSalarySubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       String
  location   String?
  baseSalary Int
  totalComp  Int?
  experience String?
  createdAt  DateTime @default(now())
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Interview {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       String?
  difficulty String?  // "easy", "medium", "hard"
  experience String?  // "positive", "negative", "neutral"
  process    String?  // comma-separated steps
  questions  Json?    // [{question: string, answer: string|null}]
  reviewDate DateTime?
  createdAt  DateTime @default(now())
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
}

model ComparisonSnapshot {
  id         String   @id @default(cuid())
  slugs      String   // JSON array of company slugs
  names      String   // JSON array of company names
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}
